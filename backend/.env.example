# Backend Environment Variables - Example
# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://slauser:slapassword@localhost:5432/sla_tracker"

# Timezone for SLA business hours calculation (e.g. Asia/Kolkata, UTC, America/New_York)
BUSINESS_TIMEZONE="Asia/Kolkata"

# JWT secret for signing auth tokens (use a long, random string in production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
